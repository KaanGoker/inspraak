DATABASE_URL=postgresql://inspraak:inspraak@localhost:5544/inspraak
REDIS_URL=redis://localhost:6390/0
LLM_PROVIDER=fake               # fake (no key, deterministic), gemini, anthropic
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   verified on the free tier 3 Oct 2026; gemini-2.5-flash-lite also works
# ANTHROPIC_API_KEY=              optional provider: uv sync --extra anthropic
# ANTHROPIC_MODEL=claude-haiku-4-5
# LLM_RPM=10                      self-imposed budget shared through Redis by every process
# LLM_RPD=300                     daily budget; when spent the job stops and reports (no looping)
# LLM_MAX_ATTEMPTS=4              retries with backoff 5, 15, 30, 60 s on 429 and 5xx
# RUN_INLINE=0                    1 runs the graph in the calling process instead of the Celery brief queue
# MATCH_TOP_K=5                   consultations per organisation run
# MATCH_MIN_SCORE=0.45            below: not shown
# MATCH_UNCERTAIN_SCORE=0.55      between min and this: shown, flagged "relevance in the uncertain band"
# DEADLINE_DAYS=7                 escalation when the feedback period closes sooner
# DRAFT_MAX_CHARS=4000            Have Your Say limit, hard cut
# ANALYST_MIN_CONFIDENCE=0.6      stance below this goes to the review queue, not to the page
# REVIEW_TOKEN=                   when set, the inbox and every POST ask for basic auth with this password
# WRITE_RATE_PER_10MIN=20         write actions per client per 10 minutes
# POSTGRES_PASSWORD=              read by docker compose at the first start; change DATABASE_URL to match

# Optional overrides, defaults in inspraak/config.py
# DATA_DIR=./data                 raw cache, downloaded files, embedding model
# EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBED_DIM=384                   must match vector(384) in the migrations
# REQUEST_INTERVAL=1.0            seconds between requests to the Commission
# CACHE_HOURS=20                  reuse cached listing, detail and open-feedback pages
# SCOPE_OPEN_DAYS=90              open publications closing within this window
# SCOPE_CLOSED_MAX=40             recently closed publications to keep
# SCOPE_CLOSED_MIN_ORG=20         minimum organisation submissions for a closed one
# SCOPE_CLOSED_LOOKBACK_DAYS=365  how far back closed candidates are considered
# SCOPE_CLOSED_SCAN_LIMIT=250     how many closed initiatives get their detail fetched
# FEEDBACK_MAX_ROWS=5000          rows per publication before the fetch stops (truncated flag)
# KEEP_ATTACHMENT_FILES=0         1 keeps feedback attachment files under data/raw (about 1.1 GB)
